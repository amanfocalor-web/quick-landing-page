# Cherub server
CHERUB_HOST=0.0.0.0
CHERUB_PORT=8787
CHERUB_API_TOKEN=replace-with-a-long-random-secret

# Cherub Core model routing
# The router chooses a path per request. These can point to the same model
# while you are developing, then be changed independently as stronger/faster
# engines are provisioned.
CHERUB_ENGINE_MODEL=./models/cherub-core
CHERUB_FAST_MODEL=./models/cherub-core
CHERUB_GENERAL_MODEL=./models/cherub-core
CHERUB_DEEP_MODEL=./models/cherub-core
CHERUB_MAX_NEW_TOKENS=700
CHERUB_FAST_MAX_NEW_TOKENS=400
CHERUB_DEEP_MAX_NEW_TOKENS=1200

# Live web research
# auto = Brave when configured, otherwise DuckDuckGo fallback
CHERUB_SEARCH_PROVIDER=auto
BRAVE_SEARCH_API_KEY=
CHERUB_SEARCH_TIMEOUT=8

# Local database for development. Use an encrypted/authenticated database in production.
CHERUB_DB=./cherub.sqlite3

# Optional direct-browser authentication for local/dev frontend use
# The backend verifies the user's Supabase access token server-side
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
