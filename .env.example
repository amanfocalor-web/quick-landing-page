VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use VITE_SUPABASE_ANON_KEY instead.

# Supabase Edge Function secret (set this in Supabase, not in Vite/browser env)
# OPENAI_API_KEY=
# Optional model override for Cherub
# CHERUB_MODEL=gpt-5.6-luna

# Cherub backend is configured in Supabase Edge Function secrets
# CHERUB_BACKEND_URL=https://your-cherub-domain.example
# CHERUB_BACKEND_TOKEN=server-only-random-secret

# Optional direct Cherub backend for local/dev deployments
# When omitted, the frontend uses the authenticated Supabase Cherub proxy
# VITE_CHERUB_BACKEND_URL=http://localhost:8787
